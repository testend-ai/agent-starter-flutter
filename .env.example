# Copy this file to assets/.env and set your configuration.
# Without it, the app connects to a default agent.

# Option 1: LiveKit Cloud Sandbox ID
LIVEKIT_SANDBOX_ID=<your-sandbox-id>

# Option 2: Direct LiveKit Server URL and Token for M2 agent / custom room
# LIVEKIT_URL=wss://your-livekit-server.com
# LIVEKIT_TOKEN=eyJ...

# Option 3: Custom token generator endpoint
# LIVEKIT_TOKEN_ENDPOINT=https://your-token-server.com/api/token

# M1 user simulator / benchmark harness config lives in m2_agent/.env.example
# (M1_MODEL_ENDPOINT / M1_API_KEY / M1_MODEL_NAME / M1_TEMPERATURE). The Flutter
# app itself never needs those values — it stays the visualizer/debugger.
