# ==============================================================================
# M2 Agent Server Configuration (LiveKit Agent Demo)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LiveKit Server Connection
# ------------------------------------------------------------------------------
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ------------------------------------------------------------------------------
# 2. M2 Workflow Selection
# Choices: "pipeline" (STT-LLM-TTS) | "realtime" (Multimodal Realtime API)
# ------------------------------------------------------------------------------
M2_WORKFLOW=pipeline

# ------------------------------------------------------------------------------
# 3. Custom Model Endpoint & API Key (Plug and Play)
# Works with any OpenAI-compatible API endpoint (OpenAI, Azure, Ollama, vLLM,
# Groq, LiteLLM, DeepSeek, Mistral, or custom SIP/LLM model proxy).
# ------------------------------------------------------------------------------
M2_MODEL_ENDPOINT=https://api.openai.com/v1
M2_MODEL_API_KEY=your_model_api_key
M2_MODEL_NAME=gpt-4o-mini
M2_TEMPERATURE=0.7

# System instructions / Persona for M2
M2_INSTRUCTIONS="You are a helpful and professional customer service voice assistant. Keep answers concise, clear, and natural for spoken dialogue."
M2_GREETING="Hello! How can I help you today?"

# ------------------------------------------------------------------------------
# 4. Speech-to-Text (STT) Configuration (Pipeline workflow)
# Provider choices: "deepgram" | "openai" (or custom OpenAI-compatible STT endpoint)
# ------------------------------------------------------------------------------
M2_STT_PROVIDER=deepgram
M2_STT_API_KEY=your_deepgram_api_key
M2_STT_MODEL=nova-2-general
# M2_STT_ENDPOINT=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 5. Text-to-Speech (TTS) Configuration (Pipeline workflow)
# Provider choices: "cartesia" | "openai" (or custom OpenAI-compatible TTS endpoint)
# ------------------------------------------------------------------------------
M2_TTS_PROVIDER=cartesia
M2_TTS_API_KEY=your_cartesia_api_key
M2_TTS_MODEL=sonic-english
M2_VOICE=79a125e8-cd45-4c13-8a67-188112f4dd22
# M2_TTS_ENDPOINT=https://api.openai.com/v1

# ==============================================================================
# M1 User Simulator + Conversation Harness (m2_agent/m1_simulator.py etc.)
# Any OpenAI-compatible endpoint works — routed via litellm, same plug-and-play
# contract as M2. Model tier guidance (user-simulator-models.md):
#   Easy/Medium   -> google/gemini-2.5-flash        ($2.50/M out, fast)
#   Hard/Adv.     -> anthropic/claude-sonnet-5      (best persona control)
#   Budget        -> deepseek/deepseek-v4-flash     ($0.28/M out)
# ==============================================================================

# M1 endpoint + key (defaults to provider default when empty; e.g. OpenRouter:
# M1_MODEL_ENDPOINT=https://openrouter.ai/api/v1)
M1_MODEL_ENDPOINT=https://openrouter.ai/api/v1
M1_API_KEY=your_m1_api_key
M1_MODEL_NAME=google/gemini-2.5-flash
M1_TEMPERATURE=0.7

# Difficulty tier for the simulated caller: easy | medium | hard | adversarial.
# Knobs (verbosity/interruption/patience/hesitation) are seeded per trial from
# (base_seed, task_id, trial) so runs replay identically.
M1_DIFFICULTY=medium
